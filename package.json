{
  "name": "peptide-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Website for research peptides. Built with Next.js, React, and TypeScript; deployed to GitHub Pages.",
  "author": "Tuggooo",
  "keywords": [
    "nextjs",
    "react",
    "typescript",
    "tailwind",
    "peptide-site"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "benchmark:build": "npm run build",
    "benchmark": "node benchmark/measure.mjs",
    "postbuild": "ln -sfn . out/peptide-site && rm -rf out/assets && cp -a assets out/assets",
    "start": "npx serve@latest out",
    "lint": "next lint",
    "validate:catalog": "node scripts/validate-catalog.mjs",
    "deploy": "next build && touch out/.nojekyll",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "cypress:open": "cd test/cypress && cypress open",
    "cypress:run": "cd test/cypress && cypress run",
    "cypress:e2e": "cd test/cypress && cypress run --spec \"e2e/**/*.cy.js\"",
    "cypress:smoke": "cd test/cypress && cypress run --spec \"smoke/**/*.cy.js\""
  },
  "homepage": "https://github.com/ACFHarbinger/peptide-site.git",
  "dependencies": {
    "@tanstack/react-form": "^1.33.4",
    "astro": "^7.3.1",
    "framer-motion": "^13.2.0",
    "lucide-react": "^1.42.0",
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-redux": "^9.3.0",
    "redux": "^5.0.1",
    "serve": "^14.2.5"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.3.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.5.5",
    "cypress": "^16.0.0",
    "eslint": "^10.10.0",
    "eslint-config-next": "^16.3.4",
    "jsdom": "^30.0.1",
    "msw": "^2.4.9",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
